# Copy to .env and fill in. `.env` is git-ignored. Never commit real keys.

# --- Atlas (same variable names as the Atlas CLI) ---
# Programmatic API key (HTTP digest auth). Needs Project Read Only or higher.
MONGODB_ATLAS_PUBLIC_API_KEY=
MONGODB_ATLAS_PRIVATE_API_KEY=
# Or a Service Account (OAuth2 client credentials). Used if both are set and API key vars are empty.
MONGODB_ATLAS_CLIENT_ID=
MONGODB_ATLAS_CLIENT_SECRET=
# Default project (group) id, 24 hex chars.
MONGODB_ATLAS_PROJECT_ID=
# Override for Atlas for Government etc. Default: https://cloud.mongodb.com
# MONGODB_ATLAS_OPS_MANAGER_URL=https://cloud.mongodb.com

# --- Ops Manager / Cloud Manager (Enterprise Advanced) - same names as mongocli ---
MONGODB_OPS_MANAGER_URL=https://opsmanager.example.internal:8443
MONGODB_OPS_MANAGER_PUBLIC_API_KEY=
MONGODB_OPS_MANAGER_PRIVATE_API_KEY=
MONGODB_OPS_MANAGER_PROJECT_ID=
# Path to CA bundle for self-signed Ops Manager TLS certs (optional)
# MONGODB_OPS_MANAGER_CA_FILE=/etc/ssl/certs/ops-manager-ca.pem

# --- Tests ---
# Live MongoDB used by the integration tests (atlas-local works well):
#   atlas deployments setup mongoops-regex-test --type local --mdbVersion 8.0 --port 27099 --force
# MONGOOPS_TEST_MONGODB_URI=mongodb://localhost:27099/?directConnection=true
